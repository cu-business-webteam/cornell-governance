{
  "name": "cornell/in-page-governance",
  "description": "Cornell's In-Page Governance Plugin",
  "version": "1.0.8",
  "authors": [
    {
      "name": "Curtiss Grymala",
      "email": "cg685@cornell.edu"
    }
  ],
  "config": {
    "vendor-dir": "vendor",
    "preferred-install": "dist"
  },
  "type": "wordpress-plugin",
  "license": "Proprietary",
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*"
      ]
    }
  ],
  "require": {
    "php": "^7.4|>=8.2",
    "erusev/parsedown": "1.8.*",
    "salesforce/handlebars-php": "3.*",
    "erusev/parsedown-extra": "dev-master",
    "yahnis-elsts/plugin-update-checker": "dev-master",
    "vlucas/phpdotenv": "^5.6@dev"
  },
  "extra": {
    "installer-paths": {
      "vendor/{$name}": [
        "type:wordpress-plugin"
      ]
    },
    "phar-builder": {
      "name": "cornell-governance.phar",
      "output-dir": "./dist/",
      "dev": false,
      "skip-shebang": true,
      "excluded": [
        "node_modules",
        "src",
        "auth.json",
        "credentials.ini",
        "cornell-governance-config.php",
        ".version",
        "build.js",
        "readme-converter.js",
        ".env"
      ],
      "compression": "bz2",
      "entry-point": "./cornell-governance.php"
    }
  },
  "autoload": {
    "psr-4": {
      "Cornell\\Governance\\": "lib/cornell/governance/classes"
    }
  },
  "require-dev": {
    "solvebeam/wp-text-domain-replacer": "dev-main",
    "varunsridharan/wp-cli-textdomain": "dev-main"
  }
}
