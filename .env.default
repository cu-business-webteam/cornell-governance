# These are the default values pointing to the authoritative public release repo
# If you would like to pull updates from your own repo, you will need to re-define these values
#       and either save them in a file called `.env` in the root directory for this plugin
#       (not recommended, since .env is a plain-text file, and these secrets would be wordly-visible),
#       add them to your own environment variables for your environment, itself, create a file called
#       cornell-governance-config.php and define them as constants in that file, or define them in
#       your wp-config file
# Essentially, the plugin is designed to check env variables with these keys first, then fall back to
#       looking for PHP global constants with these keys
#
# @see https://github.com/YahnisElsts/plugin-update-checker
CORNELL_GOVERNANCE_REPO_URL=https://github.com/cu-business-webteam/cornell-governance
CORNELL_GOVERNANCE_REPO_SLUG=cornell-governance
CORNELL_GOVERNANCE_REPO_BRANCH=main

# If you are using a private Bitbucket repo, you will need to define a consumer key and secret
# CORNELL_GOVERNANCE_REPO_CONSUMER_KEY=your-key-here
# CORNELL_GOVERNANCE_REPO_CONSUMER_SECRET=your-secret-here

# If you are using a private GitLab repo, you will need to set an authorization token
# CORNELL_GOVERNANCE_REPO_AUTH_TOKEN=your-token-here

# If you are using a custom/self-hosted GitLab server, you need to indicate that
# CORNELL_GOVERNANCE_REPO_IS_CUSTOM_GITLAB=true