#!/usr/bin/env php
<?php

/**
 * Find and load Composer autoloader.
 */
$autoload_paths = [
	__DIR__ . '/../vendor/autoload.php',
	__DIR__ . '/../../../autoload.php',
];

foreach ( $autoload_paths as $autoload_path ) {
	if ( file_exists( $autoload_path ) ) {
		require_once $autoload_path;

		break;
	}
}

$options = getopt(
	'',
	[
		'dir::',
		'exclude::',
		'output::',
		'search:',
		'replace:',
	]
);

// Load configuration from composer.json.
$composer_config = [];

$composer_file = getcwd() . '/composer.json';

if ( file_exists( $composer_file ) ) {
	$composer_json = json_decode( file_get_contents( $composer_file ), true );
	if ( isset( $composer_json['extra']['solvebeam-wp-text-domain-replacer'] ) ) {
		$composer_config = $composer_json['extra']['solvebeam-wp-text-domain-replacer'];
	}
}

// Start with composer.json values.
$dir     = $composer_config['dir'] ?? getcwd();
$exclude = $composer_config['exclude'] ?? [];
$output  = $composer_config['output'] ?? null;
$search  = $composer_config['search'] ?? null;
$replace = $composer_config['replace'] ?? null;

// Override with CLI options.
if ( array_key_exists( 'dir', $options ) ) {
	$dir = $options['dir'];
}

if ( array_key_exists( 'exclude', $options ) ) {
	$exclude = $options['exclude'];
}

if ( array_key_exists( 'output', $options ) ) {
	$output = $options['output'];
}

if ( array_key_exists( 'search', $options ) ) {
	$search = $options['search'];
}

if ( array_key_exists( 'replace', $options ) ) {
	$replace = $options['replace'];
}

// Normalize exclude to array.
if ( ! is_array( $exclude ) ) {
	$exclude = [ $exclude ];
}

// Normalize search domain to array.
if ( ! is_array( $search ) ) {
	$search = [ $search ];
}

// Validate required parameters.
if ( $search === null ) {
	fwrite( STDERR, "Error: --search is required (via command-line or composer.json)\n" );
	exit( 1 );
}

if ( $replace === null ) {
	fwrite( STDERR, "Error: --replace is required (via command-line or composer.json)\n" );
	exit( 1 );
}

echo 'Working directory: ', $dir, PHP_EOL;
echo 'Excluding directories: ', implode( ', ', $exclude ), PHP_EOL;

if ( $output !== null ) {
	echo 'Output directory: ', $output, PHP_EOL;
}

echo 'Search domains: ', implode( ', ', $search ), PHP_EOL;
echo 'Replace domain: ', $replace, PHP_EOL;

/**
 * Get the output file path.
 *
 * @param SplFileInfo $file   File.
 * @param string      $dir    Input directory.
 * @param string|null $output Output directory.
 * @return string
 */
function get_output_path( SplFileInfo $file, string $dir, ?string $output ): string {
	if ( $output === null ) {
		return $file->getPathname();
	}

	$relative    = substr( $file->getPathname(), strlen( rtrim( $dir, '/' ) ) + 1 );
	$output_file = rtrim( $output, '/' ) . '/' . $relative;
	$output_dir  = dirname( $output_file );

	if ( ! is_dir( $output_dir ) ) {
		mkdir( $output_dir, 0755, true );
	}

	return $output_file;
}

$directory_iterator = new RecursiveDirectoryIterator(
	$dir,
	RecursiveDirectoryIterator::SKIP_DOTS
);

$exclude_filter_iterator = new RecursiveCallbackFilterIterator(
	$directory_iterator,
	function ( $current ) use ( $exclude ) {
		return ! in_array( $current->getFilename(), $exclude, true );
	}
);

$block_json_filter_iterator = new RecursiveCallbackFilterIterator(
	$exclude_filter_iterator,
	function ( $current ) {
		if ( $current->isDir() ) {
			return true;
		}

		return $current->isFile() && $current->getFilename() === 'block.json';
	}
);

$block_json_files = new RecursiveIteratorIterator( $block_json_filter_iterator );

foreach ( $block_json_files as $file ) {
	echo "[INFO] Processing: ", $file->getPathname(), PHP_EOL;

	$contents = file_get_contents( $file );

	$pattern = '/(?<prefix>"textdomain"\s*:\s*")(?<domain>[a-zA-Z0-9_-]+)(?<suffix>")/';

	$replaced = preg_replace_callback(
		$pattern,
		function ( $matches ) use ( $search, $replace ) {
			if ( in_array( $matches['domain'], $search, true ) ) {
				return $matches['prefix'] . $replace . $matches['suffix'];
			}

			return $matches[0];
		},
		$contents
	);

	if ( $replaced !== $contents ) {
		$output_path = get_output_path( $file, $dir, $output );

		file_put_contents( $output_path, $replaced );

		echo "[SUCCESS] Text domain replaced in: ", $output_path, PHP_EOL;
	} else {
		if ( $output !== null ) {
			$output_path = get_output_path( $file, $dir, $output );

			file_put_contents( $output_path, $contents );
		}

		echo "[SKIP] No replacement needed for: ", $file->getPathname(), PHP_EOL;
	}
}

/**
 * PHP functions.
 *
 * @link https://github.com/WordPress/WordPress-Coding-Standards/blob/38168bc542ec3565c04f2a88498a2024cdfd9ba1/WordPress/Sniffs/Utils/I18nTextDomainFixerSniff.php#L72-L229
 */
$php_functions = [
	'load_textdomain'             => [
		'position' => 1,
		'name'     => 'domain',
	],
	'load_plugin_textdomain'      => [
		'position' => 1,
		'name'     => 'domain',
	],
	'load_muplugin_textdomain'    => [
		'position' => 1,
		'name'     => 'domain',
	],
	'load_theme_textdomain'       => [
		'position' => 1,
		'name'     => 'domain',
	],
	'load_child_theme_textdomain' => [
		'position' => 1,
		'name'     => 'domain',
	],
	'load_script_textdomain'      => [
		'position' => 2,
		'name'     => 'domain',
	],
	'unload_textdomain'           => [
		'position' => 1,
		'name'     => 'domain',
	],

	'__'                          => [
		'position' => 2,
		'name'     => 'domain',
	],
	'_e'                          => [
		'position' => 2,
		'name'     => 'domain',
	],
	'_x'                          => [
		'position' => 3,
		'name'     => 'domain',
	],
	'_ex'                         => [
		'position' => 3,
		'name'     => 'domain',
	],
	'_n'                          => [
		'position' => 4,
		'name'     => 'domain',
	],
	'_nx'                         => [
		'position' => 5,
		'name'     => 'domain',
	],
	'_n_noop'                     => [
		'position' => 3,
		'name'     => 'domain',
	],
	'_nx_noop'                    => [
		'position' => 4,
		'name'     => 'domain',
	],
	'translate_nooped_plural'     => [
		'position' => 3,
		'name'     => 'domain',
	],

	'esc_html__'                  => [
		'position' => 2,
		'name'     => 'domain',
	],
	'esc_html_e'                  => [
		'position' => 2,
		'name'     => 'domain',
	],
	'esc_html_x'                  => [
		'position' => 3,
		'name'     => 'domain',
	],
	'esc_attr__'                  => [
		'position' => 2,
		'name'     => 'domain',
	],
	'esc_attr_e'                  => [
		'position' => 2,
		'name'     => 'domain',
	],
	'esc_attr_x'                  => [
		'position' => 3,
		'name'     => 'domain',
	],

	'is_textdomain_loaded'        => [
		'position' => 1,
		'name'     => 'domain',
	],
	'get_translations_for_domain' => [
		'position' => 1,
		'name'     => 'domain',
	],
];

/**
 * JavaScript functions.
 *
 * @link https://github.com/WordPress/gutenberg/blob/ab5c79cd40adbb68898536c50e035b0a734338ea/packages/i18n/src/index.js#L9-L12
 */
$js_functions = [
	'__'  => [
		'position' => 2,
		'name'     => 'domain',
	],
	'_x'  => [
		'position' => 3,
		'name'     => 'domain',
	],
	'_n'  => [
		'position' => 4,
		'name'     => 'domain',
	],
	'_nx' => [
		'position' => 5,
		'name'     => 'domain',
	],
];

/**
 * PHP processing with nikic/php-parser.
 *
 * @link https://github.com/nikic/php-parser
 */
$php_filter_iterator = new RecursiveCallbackFilterIterator(
	$exclude_filter_iterator,
	function ( $current ) {
		if ( $current->isDir() ) {
			return true;
		}

		return $current->isFile() && $current->getExtension() === 'php';
	}
);

$php_files = new RecursiveIteratorIterator( $php_filter_iterator );

$parser  = ( new PhpParser\ParserFactory() )->createForNewestSupportedVersion();
$printer = new PhpParser\PrettyPrinter\Standard();

foreach ( $php_files as $file ) {
	echo "[INFO] Processing: ", $file->getPathname(), PHP_EOL;

	$original = file_get_contents( $file );

	try {
		$old_stmts = $parser->parse( $original );
	} catch ( PhpParser\Error $e ) {
		echo "[ERROR] Parse error in: ", $file->getPathname(), " - ", $e->getMessage(), PHP_EOL;

		continue;
	}

	$old_tokens = $parser->getTokens();

	$traverser = new PhpParser\NodeTraverser(
		new PhpParser\NodeVisitor\CloningVisitor()
	);
	$new_stmts = $traverser->traverse( $old_stmts );

	$modifier = new PhpParser\NodeTraverser();

	$modifier->addVisitor(
		new class($search, $replace, $php_functions) extends PhpParser\NodeVisitorAbstract {
			/**
			 * Search domains.
			 *
			 * @var string[]
			 */
			private array $search;

			/**
			 * Replace domain.
			 *
			 * @var string
			 */
			private string $replace;

			/**
			 * Functions.
			 *
			 * @var array
			 */
			private array $functions;

			/**
			 * Construct.
			 *
			 * @param string[] $search    Search domains.
			 * @param string   $replace   Replace domain.
			 * @param array    $functions Functions.
			 */
			public function __construct( array $search, string $replace, array $functions ) {
				$this->search    = $search;
				$this->replace   = $replace;
				$this->functions = $functions;
			}

			/**
			 * Enter node.
			 *
			 * @param PhpParser\Node $node Node.
			 * @return void
			 */
			public function enterNode( PhpParser\Node $node ) {
				if ( !$node instanceof PhpParser\Node\Expr\FuncCall ) {
					return;
				}

				if ( !$node->name instanceof PhpParser\Node\Name ) {
					return;
				}

				// Directly use the unqualified name as global fallback.
				$func_name = $node->name->toLowerString();

				if ( ! isset( $this->functions[$func_name] ) ) {
					return;
				}

				$position = $this->functions[$func_name]['position'];
				$arg_index = $position - 1;

				if ( ! isset( $node->args[$arg_index] ) ) {
					return;
				}

				$arg = $node->args[$arg_index];

				if ( !$arg->value instanceof PhpParser\Node\Scalar\String_ ) {
					return;
				}

				if ( in_array( $arg->value->value, $this->search, true ) ) {
					$arg->value->value = $this->replace;
				}
			}
		}
	);

	$new_stmts = $modifier->traverse( $new_stmts );
	$new_code  = $printer->printFormatPreserving( $new_stmts, $old_stmts, $old_tokens );

	if ( $new_code !== $original ) {
		$output_path = get_output_path( $file, $dir, $output );

		file_put_contents( $output_path, $new_code );

		echo "[SUCCESS] Text domain replaced in: ", $output_path, PHP_EOL;
	} else {
		if ( $output !== null ) {
			$output_path = get_output_path( $file, $dir, $output );

			file_put_contents( $output_path, $original );
		}

		echo "[SKIP] No replacement needed for: ", $file->getPathname(), PHP_EOL;
	}
}

/**
 * JavaScript processing with mck89/peast.
 *
 * @link https://github.com/mck89/peast
 */
$js_filter_iterator = new RecursiveCallbackFilterIterator(
	$exclude_filter_iterator,
	function ( $current ) {
		if ( $current->isDir() ) {
			return true;
		}

		return $current->isFile() && $current->getExtension() === 'js';
	}
);

$js_files = new RecursiveIteratorIterator( $js_filter_iterator );

foreach ( $js_files as $file ) {
	echo "[INFO] Processing: ", $file->getPathname(), PHP_EOL;

	$original = file_get_contents( $file );

	try {
		$ast = Peast\Peast::latest( $original )->parse();
	} catch ( Exception $e ) {
		echo "[ERROR] Parse error in: ", $file->getPathname(), " - ", $e->getMessage(), PHP_EOL;

		continue;
	}

	$replacements = [];

	$ast->traverse( function ( $node ) use ( $js_functions, $search, $replace, $original, &$replacements ) {
		if ( $node->getType() !== 'CallExpression' ) {
			return;
		}

		$callee = $node->getCallee();

		if ( $callee->getType() !== 'Identifier' ) {
			return;
		}

		$func_name = $callee->getName();

		if ( ! isset( $js_functions[ $func_name ] ) ) {
			return;
		}

		$position  = $js_functions[ $func_name ]['position'];
		$arg_index = $position - 1;

		$arguments = $node->getArguments();

		if ( ! isset( $arguments[ $arg_index ] ) ) {
			return;
		}

		$arg = $arguments[ $arg_index ];

		if ( ! $arg instanceof Peast\Syntax\Node\StringLiteral ) {
			return;
		}

		$value = $arg->getValue();

		if ( ! in_array( $value, $search, true ) ) {
			return;
		}

		$location = $arg->getLocation();
		$start    = $location->getStart()->getIndex();
		$end      = $location->getEnd()->getIndex();

		$replacements[] = [
			'start' => $start,
			'end'   => $end,
			'quote' => $original[ $start ],
		];
	} );

	if ( empty( $replacements ) ) {
		if ( $output !== null ) {
			$output_path = get_output_path( $file, $dir, $output );

			file_put_contents( $output_path, $original );
		}

		echo "[SKIP] No replacement needed for: ", $file->getPathname(), PHP_EOL;

		continue;
	}

	// Apply replacements in reverse order to preserve positions.
	usort( $replacements, fn ( $a, $b ) => $b['start'] - $a['start'] );

	$contents = $original;

	foreach ( $replacements as $rep ) {
		$contents = substr_replace(
			$contents,
			$rep['quote'] . $replace . $rep['quote'],
			$rep['start'],
			$rep['end'] - $rep['start']
		);
	}

	if ( $contents !== $original ) {
		$output_path = get_output_path( $file, $dir, $output );

		file_put_contents( $output_path, $contents );

		echo "[SUCCESS] Text domain replaced in: ", $output_path, PHP_EOL;
	} else {
		echo "[SKIP] No replacement needed for: ", $file->getPathname(), PHP_EOL;
	}
}
